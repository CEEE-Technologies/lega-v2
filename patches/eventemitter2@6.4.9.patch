+    // Lega patch: wait for every listener before passing on the first
+    // error. With Promise.all a failing listener rejected at once while
+    // the others kept writing to a transaction the caller was undoing.
+    return Promise.allSettled(promises).then(function (results) {
+      var values = new Array(results.length);
+      for (var k = 0; k < results.length; k++) {
+        if (results[k].status === 'rejected') throw results[k].reason;
+        values[k] = results[k].value;
+      }
+      return values;
+    });
   };
 
